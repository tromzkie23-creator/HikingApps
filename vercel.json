{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix trailhead-api ci --omit=dev",
  "builds": [
    {
      "src": "trailhead-api/api/login.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/password.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/profile.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/posts/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/posts/[id].ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/posts/[id]/like.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/posts/[id]/comments.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/upload.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/register.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/hikes/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/favorites.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/stats.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/trails/[id]/reviews.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/trails/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "trailhead-api/api/trails/[id].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/favorites/?$",
      "dest": "/trailhead-api/api/favorites.ts"
    },
    {
      "src": "^/api/stats/?$",
      "dest": "/trailhead-api/api/stats.ts"
    },
    {
      "src": "^/api/trails/([^/]+)/reviews/?$",
      "dest": "/trailhead-api/api/trails/[id]/reviews.ts?id=$1"
    },
    {
      "src": "^/api/trails/?$",
      "dest": "/trailhead-api/api/trails/index.ts"
    },
    {
      "src": "^/api/trails/([^/]+)/?$",
      "dest": "/trailhead-api/api/trails/[id].ts?id=$1"
    },
    {
      "src": "^/api/login/?$",
      "dest": "/trailhead-api/api/login.ts"
    },
    {
      "src": "^/api/password/?$",
      "dest": "/trailhead-api/api/password.ts"
    },
    {
      "src": "^/api/profile/?$",
      "dest": "/trailhead-api/api/profile.ts"
    },
    {
      "src": "^/api/posts/?$",
      "dest": "/trailhead-api/api/posts/index.ts"
    },
    {
      "src": "^/api/posts/([^/]+)/like/?$",
      "dest": "/trailhead-api/api/posts/[id]/like.ts?id=$1"
    },
    {
      "src": "^/api/posts/([^/]+)/comments/?$",
      "dest": "/trailhead-api/api/posts/[id]/comments.ts?id=$1"
    },
    {
      "src": "^/api/posts/([^/]+)/?$",
      "dest": "/trailhead-api/api/posts/[id].ts?id=$1"
    },
    {
      "src": "^/api/upload/?$",
      "dest": "/trailhead-api/api/upload.ts"
    },
    {
      "src": "^/api/register/?$",
      "dest": "/trailhead-api/api/register.ts"
    },
    {
      "src": "^/api/hikes/?$",
      "dest": "/trailhead-api/api/hikes/index.ts"
    }
  ]
}
